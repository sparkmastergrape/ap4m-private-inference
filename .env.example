# Variable NAMES only. Never real values, never committed.
# Step 1 of the build order needs NONE of these: estimate.ts and the boundary
# check run with an empty environment.

# --- AP4M service and chain -------------------------------------------------
AP4M_API_URL=
TEAM_NAME=
# Optional: overrides network.rpcUrl from GET /public/config.
AP4M_RPC_URL=

# --- Agent side (tenant PC) -------------------------------------------------
# The buyer EVM wallet: funding wallet, Agent Principal and Agent in one (allowed).
# It signs sign-in, the one channel-request transaction (gas) and every Voucher (gasless).
AGENT_PRIVATE_KEY=

# --- Merchant side (ChainAim) ----------------------------------------------
# Our own Merchant ID from the portal, not one of the pool merchants.
MERCHANT_ID=
# Payout address. MUST differ from the agent and funding wallets.
MERCHANT_PAYOUT=
# Pays gas for redeemVoucher. May be the payout wallet.
MERCHANT_SUBMITTER_KEY=

# --- ChainAim infrastructure, reached by HTTP only -------------------------
GATEWAY_URL=
GATEWAY_KEY=
CLIENT_PRIVACY_URL=

# --- Bedrock ---------------------------------------------------------------
# Credentials come from the normal AWS chain (AWS_PROFILE or SSO), never from here.
AWS_REGION=
